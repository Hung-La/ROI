<Window x:Class="ROI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ROI.Controls"
        mc:Ignorable="d"
        Title="WPF ROI (Region of Interest) Inspector - Manh Hung"
        Height="900" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <DockPanel LastChildFill="False">
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnOpenImage"
                            Content="📂 Mở ảnh..."
                            Click="BtnOpenImage_Click"
                            Margin="0,0,8,0" />

                    <Button x:Name="BtnSampleImage"
                            Style="{StaticResource PrimaryButton}"
                            Content="⚡ Tạo ảnh mẫu"
                            Click="BtnSampleImage_Click"
                            Margin="0,0,8,0" />

                    <Separator Style="{x:Null}" Width="1" Background="{StaticResource BorderDark}" Margin="4,2,12,2" />

                    <Button x:Name="BtnFullRoi"
                            Content="🎯 Chọn toàn hình"
                            Click="BtnFullRoi_Click"
                            Margin="0,0,8,0" />

                    <Button x:Name="BtnCenterRoi"
                            Content="◻️ ROI trung tâm"
                            Click="BtnCenterRoi_Click"
                            Margin="0,0,8,0" />

                    <Button x:Name="BtnClearRoi"
                            Content="🧹 Xóa ROI"
                            Click="BtnClearRoi_Click"
                            Margin="0,0,8,0" />
                </StackPanel>

                <!-- Options / Toggles -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Màu ROI:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" FontSize="12" />
                    <ComboBox x:Name="CmbColor"
                              Width="105"
                              Height="28"
                              SelectionChanged="CmbColor_SelectionChanged"
                              Margin="0,0,16,0"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="{StaticResource BorderDark}"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Xanh lá" Tag="#00E676" />
                        <ComboBoxItem Content="Xanh lam" Tag="#38BDF8" />
                        <ComboBoxItem Content="Vàng cam" Tag="#F59E0B" />
                        <ComboBoxItem Content="Đỏ hồng" Tag="#F43F5E" />
                        <ComboBoxItem Content="Tím sáng" Tag="#A855F7" />
                    </ComboBox>

                    <CheckBox x:Name="ChkDimOverlay"
                              Content="Làm tối ngoài ROI"
                              IsChecked="True"
                              Margin="0,0,14,0" />

                    <CheckBox x:Name="ChkCrosshair"
                              Content="Tâm (+)"
                              IsChecked="True"
                              Margin="0,0,14,0" />

                    <CheckBox x:Name="ChkCoords"
                              Content="Nhãn tọa độ"
                              IsChecked="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Content Grid -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <!-- Left: ROI Viewport -->
                <ColumnDefinition Width="*" />
                <!-- Right: Control / Inspection Panel -->
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ROI Interactive Viewport -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Margin="0,0,12,0">
                <controls:RoiViewer x:Name="RoiCtrl"
                                    ShowDimmedOverlay="{Binding IsChecked, ElementName=ChkDimOverlay, FallbackValue=True}"
                                    ShowCenterCrosshair="{Binding IsChecked, ElementName=ChkCrosshair, FallbackValue=True}"
                                    ShowCoordinates="{Binding IsChecked, ElementName=ChkCoords, FallbackValue=True}"
                                    RoiChangedByUser="RoiCtrl_RoiChangedByUser" />
            </Border>

            <!-- Right Sidebar Panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- CARD 1: ROI Coordinates -->
                    <Border Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderDark}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📐 TỌA ĐỘ ROI (PIXEL GỐC)"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentBlue}"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- X -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                    <TextBlock Text="Tọa độ X (px):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtRoiX" Text="0" KeyDown="TxtRoiCoord_KeyDown" />
                                </StackPanel>

                                <!-- Y -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                    <TextBlock Text="Tọa độ Y (px):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtRoiY" Text="0" KeyDown="TxtRoiCoord_KeyDown" />
                                </StackPanel>

                                <!-- Width -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Chiều rộng W (px):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtRoiWidth" Text="0" KeyDown="TxtRoiCoord_KeyDown" />
                                </StackPanel>

                                <!-- Height -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Chiều cao H (px):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtRoiHeight" Text="0" KeyDown="TxtRoiCoord_KeyDown" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnApplyCoords"
                                    Content="✔ Áp dụng tọa độ nhập tay"
                                    Click="BtnApplyCoords_Click"
                                    Margin="0,0,0,10" />

                            <Separator Style="{x:Null}" Height="1" Background="{StaticResource BorderDark}" Margin="0,4,0,8" />

                            <Grid Margin="0,2">
                                <TextBlock Text="Diện tích ROI:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="TxtRoiArea" Text="0 px²" HorizontalAlignment="Right" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Tỷ lệ khung hình (W:H):" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="TxtRoiAspect" Text="0:0" HorizontalAlignment="Right" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Kích thước ảnh nguồn:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="TxtImageResolution" Text="Chưa có ảnh" HorizontalAlignment="Right" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Crop & Export ROI -->
                    <Border Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderDark}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✂️ CẮT &amp; XUẤT VÙNG ROI"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentColor}"
                                       Margin="0,0,0,10" />

                            <Button x:Name="BtnCropRoi"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="✂️ Cắt vùng ROI ngay"
                                    Click="BtnCropRoi_Click"
                                    Margin="0,0,0,10" />

                            <!-- Cropped Preview Container -->
                            <Border Background="#090D16"
                                    BorderBrush="{StaticResource BorderDark}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="150"
                                    Margin="0,0,0,8"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ImgCroppedPreview"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <TextBlock x:Name="TxtNoPreview"
                                               Text="Xem trước ảnh cắt ROI sẽ hiển thị tại đây"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="20" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtCropDimension"
                                       Text="Chưa cắt ảnh"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <Button x:Name="BtnSaveCrop"
                                    Content="💾 Lưu ảnh ROI đã cắt..."
                                    Click="BtnSaveCrop_Click"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: User Guide -->
                    <Border Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderDark}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="💡 HƯỚNG DẪN THAO TÁC"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#FBBF24"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="• Kéo chuột trên ảnh: Vẽ vùng ROI mới." Foreground="#CBD5E1" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                            <TextBlock Text="• Kéo bên trong khung ROI: Di chuyển toàn bộ vùng." Foreground="#CBD5E1" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                            <TextBlock Text="• Kéo 8 điểm neo trắng: Co giãn kích thước theo các hướng." Foreground="#CBD5E1" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                            <TextBlock Text="• Phím mũi tên (← ↑ → ↓): Vi chỉnh 1 pixel (Shift + phím: 10px)." Foreground="#CBD5E1" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                            <TextBlock Text="• Phím Esc: Hủy/Xóa vùng ROI hiện tại." Foreground="#CBD5E1" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                            <TextBlock Text="• Tọa độ tự động giới hạn (clamp) trong ranh giới ảnh gốc." Foreground="{StaticResource AccentBlue}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus"
                           Text="Sẵn sàng"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="TxtRoiStatus"
                           Text="ROI: Chưa thiết lập"
                           Foreground="{StaticResource AccentColor}"
                           FontWeight="SemiBold"
                           FontSize="11"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
